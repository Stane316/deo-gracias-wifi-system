# W2/P6 — environnement d'exécution : local | test | staging | production
# APP_ENV est obligatoire : ne pas laisser le runtime choisir implicitement.
# production refuse les modes DEV et exige FedaPay live + Supabase configuré.
APP_ENV=local
HOST=0.0.0.0
PORT=3000
WORKERS=on

# ATTENTION — ne pas confondre :
#  DATABASE_URL  = chaîne de connexion POSTGRES : postgres://postgres.[ref]:MOT_DE_PASSE@db.[ref].supabase.co:5432/postgres
#                  (Supabase : Project Settings → Database → Connection string → URI, Direct connection)
#  SUPABASE_URL  = URL du projet https://[ref].supabase.co (Settings → API) — pour l'auth admin, pas pour la base.
# Le backend refuse de démarrer si DATABASE_URL ne commence pas par postgres:// (IMP-25.4).
DATABASE_URL=
# IMP-26 UX 6 (D-UX6a) — phrase secrète du coffre chiffré des codes Wi-Fi.
# Absente => codes non consultables en ligne (503 honnête). Jamais au repo.
TICKET_VAULT_KEY=
# IMP-14 — FedaPay (clés sandbox puis live ; JAMAIS de valeur dans le repo)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# sandbox (défaut) | live
FEDAPAY_ENVIRONMENT=sandbox
# IMP-21 — auth du Connector : token long-lived dédié (blueprint §7) ; vide => routes /connector 503
CONNECTOR_TOKEN=

# IMP-13 — Auth (locales ou cloud ; anon key = publique par conception, blueprint §7)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Variables publiques injectées par Vite dans le navigateur (jamais de service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 1 = mode développement : le code OTP client est retourné dans la réponse (JAMAIS en production)
AUTH_DEV_MODE=
# IMP-25 — DÉMO LOCALE UNIQUEMENT (GUIDE-09) : jeton admin statique actif seulement si
# Supabase est absent ET AUTH_DEV_MODE=1 (JAMAIS en production ; production = Supabase Auth)
DEV_ADMIN_TOKEN=
# IMP-25 — DÉMO LOCALE UNIQUEMENT : 1 = paiement simulé (DevPaymentProvider + /webhooks/dev-approve),
# ignoré si FEDAPAY_SECRET_KEY est définie (JAMAIS en production)
PAYMENT_DEV_MODE=
